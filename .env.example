# Copy to .env.local and fill in real values. Never commit .env.local.

# Local: npm run db:start creates this database automatically.
# Atlas/production: paste your cloud connection string here.
MONGODB_URI=mongodb://127.0.0.1:27017/studiospace

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Base URL of the app (Vercel URL in production)
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (Google Cloud Console -> Credentials -> OAuth client).
# While empty, the Google buttons show a "not configured" toast (see authentication.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
